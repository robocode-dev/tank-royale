{
  "allowedLicenses": ["MIT", "Apache-2.0", "BSD-3-Clause", "GPL-3.0-or-later"],
  "platforms": {
    "java": { "extension": ".java", "platform": "JVM", "apiToken": "dev.robocode.tankroyale.botapi" },
    "csharp": { "extension": ".cs", "platform": "C#", "apiToken": "Robocode.TankRoyale.BotApi" },
